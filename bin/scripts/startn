#!/usr/bin/env python3
"""startn: Generate niri config from a template, then start niri."""

import argparse
import os
import subprocess

CONFIG_DIR = os.path.expanduser("~/.config/niri")
TEMPLATE = os.path.join(CONFIG_DIR, "config-template.kdl")
OUTPUT = os.path.join(CONFIG_DIR, "config-generated.kdl")

HEADER = "// This file is auto-generated by `startn`. Do not edit.\n"

CONFIG_INCLUDES = {
    "main": 'include "main/config.kdl"',
    "test": 'include "test/config.kdl"',
}

DRM_INCLUDES = {
    "i": 'include "drm-selector/drm-intel.kdl"',
    "d": 'include "drm-selector/drm-default.kdl"',
    "n": 'include "drm-selector/drm-nvidia.kdl"',
}


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="startn",
        description="Generate niri config from a template, then start niri.",
    )
    parser.add_argument(
        "-c", "--config", metavar="CONFIG",
        choices=sorted(CONFIG_INCLUDES), default="main",
        help="config to use (default: %(default)s)",
    )
    parser.add_argument(
        "drm", metavar="DRM", nargs="?",
        choices=sorted(DRM_INCLUDES), default="n",
        help="DRM device: i=intel, d=default, n=nvidia (default: %(default)s)",
    )
    args = parser.parse_args()

    with open(TEMPLATE, encoding="utf-8") as f:
        content = f.read()

    content = content.replace("BASE_SWITCH", CONFIG_INCLUDES[args.config])
    content = content.replace("DRM_SWITCH", DRM_INCLUDES[args.drm])
    content = HEADER + content
    if not content.endswith("\n"):
        content += "\n"

    with open(OUTPUT, "w", encoding="utf-8") as f:
        f.write(content)

    print(f"Wrote {OUTPUT} (config={args.config}, drm={args.drm})")

    subprocess.run(["niri-session"])


if __name__ == "__main__":
    main()
